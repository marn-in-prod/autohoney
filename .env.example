# AutoHoney Pipeline — Environment Variables
# Copy this file to .env and configure one of the auth routes below.

# Auth route 1: Anthropic API key for Claude Agent SDK generation stages.
# Auth route 2: leave this unset and run `claude`, then complete /login.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override the default agent model
# HONEYPOT_AGENT_MODEL=claude-opus-4-6

# Optional: Override the Claude Code CLI used by the Claude Agent SDK.
# By default AutoHoney uses the installed `claude` on PATH when available.
# HONEYPOT_AGENT_CLI_PATH=/path/to/claude

# Optional: Override the default judge model
# HONEYPOT_JUDGE_MODEL=claude-opus-4-6

# OPENROUTER_API_KEY=your_openrouter_key